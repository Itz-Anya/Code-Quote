{
  "name": "CodeQuote — Beautiful Coding Quotes for GitHub README",
  "short_name": "CodeQuote",
  "description": "Generates a self-contained SVG coding-quote card you can embed directly in a GitHub README.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#0d1117",
  "background_color": "#0d1117",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
